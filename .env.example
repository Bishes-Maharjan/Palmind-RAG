# Application
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# Database (PostgreSQL with asyncpg)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ragdb

# Redis (Chat memory and booking slot state)
REDIS_URL=redis://localhost:6379/0
REDIS_CHAT_TTL_SECONDS=86400
REDIS_MAX_TURNS=10

# Vector Database (Qdrant)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=document_chunks

# LLM & Embeddings (OpenAI / OpenAI-compatible endpoint)
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_BASE_URL=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536

# RAG & Chunking Parameters
MAX_UPLOAD_SIZE_BYTES=10485760
RAG_TOP_K=4
RAG_SCORE_THRESHOLD=0.3
FIXED_CHUNK_SIZE=500
FIXED_CHUNK_OVERLAP=100
SEMANTIC_SIMILARITY_THRESHOLD=0.75
SEMANTIC_MIN_CHUNK_SIZE=100
SEMANTIC_MAX_CHUNK_SIZE=1000
